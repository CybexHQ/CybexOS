# Cybex OS Plymouth Theme Script
#
# The installation medium's variant, cybexos-installer, is this script after
# one line that sets global.installation_medium (nix/packages/plymouth.nix):
# its boot shows a progress bar from the start (see "Installation medium").

# Black, like the boot menu and GRUB's screen while it loads the system.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# The logo's centre sits 38% from the top, where the GRUB menu draws it
# (desktop/boot/theme.py), so it stays in place from the boot menu onwards.
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX (Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY (Window.GetHeight() * 0.38 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity (1);

# Use these to adjust the progress bar timing
global.fake_progress_limit = 0.7;  # Target percentage for fake progress (0.0 to 1.0)
global.fake_progress_duration = 15.0;  # Duration in seconds to reach limit

# Progress bar animation variables
global.fake_progress = 0.0;
global.real_progress = 0.0;
global.fake_progress_active = 0; # 0 / 1 boolean
global.animation_frame = 0;
global.fake_progress_start_time = 0;  # Track when fake progress started
global.password_shown = 0;  # Track if password dialog has been shown
global.max_progress = 0.0;  # Track the maximum progress reached to prevent backwards movement
global.layout_width = 0;
global.layout_height = 0;

fun refresh_callback ()
  {
    update_layout();
    global.animation_frame++;

    # Wiz fades out over his last 20 frames.
    global.wiz_frame++;
    if (global.wiz_until > 0)
      {
        frames_left = global.wiz_until - global.wiz_frame;
        if (frames_left <= 0)
          wiz_hide();
        else if (frames_left < 20)
          wiz.sprite.SetOpacity(frames_left / 20);
      }

    if (global.medium_active == 1)
      medium_refresh();

    # Animate fake progress to limit over time with easing
    if (global.fake_progress_active == 1)
      {
        # Calculate elapsed time since start
        elapsed_time = global.animation_frame / 50.0;  # Convert frames to seconds (50 FPS)

        # Calculate linear progress ratio (0 to 1) based on time
        time_ratio = elapsed_time / global.fake_progress_duration;
        if (time_ratio > 1.0)
          time_ratio = 1.0;

        # Apply easing curve: ease-out quadratic
        # Formula: 1 - (1 - x)^2
        eased_ratio = 1 - ((1 - time_ratio) * (1 - time_ratio));

        # Calculate fake progress based on eased ratio
        global.fake_progress = eased_ratio * global.fake_progress_limit;

        # Update progress bar with fake progress
        update_progress_bar(global.fake_progress);
      }
  }

#----------------------------------------- Helper Functions --------------------------------

fun update_progress_bar(progress)
  {
    # Only update if progress is moving forward
    if (progress > global.max_progress)
      {
        global.max_progress = progress;
        width = Math.Int(progress_bar.original_image.GetWidth() * progress);
        if (width < 1) width = 1;  # Ensure minimum width of 1 pixel

        progress_bar.image = progress_bar.original_image.Scale(width, progress_bar.original_image.GetHeight());
        progress_bar.sprite.SetImage(progress_bar.image);
      }
  }

fun show_progress_bar()
  {
    progress_box.sprite.SetOpacity(1);
    progress_bar.sprite.SetOpacity(1);
  }

fun hide_progress_bar()
  {
    progress_box.sprite.SetOpacity(0);
    progress_bar.sprite.SetOpacity(0);
  }

fun show_password_dialog()
  {
    entry.sprite.SetOpacity(1);
  }

fun hide_password_dialog()
  {
    entry.sprite.SetOpacity(0);
    for (index = 0; bullet.sprites[index]; index++)
      bullet.sprites[index].SetOpacity(0);
  }

fun start_fake_progress()
  {
    # Don't reset if we already have progress
    if (global.max_progress == 0.0)
      {
        global.fake_progress = 0.0;
        global.real_progress = 0.0;
        update_progress_bar(0.0);
      }
    global.fake_progress_active = 1;
    global.animation_frame = 0;
  }

fun stop_fake_progress()
  {
    global.fake_progress_active = 0;
  }

#----------------------------------------- Dialogue --------------------------------

entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

# Wiz, the assistant's character, stands on the passphrase field while a disk
# unlock prompt shows, and never on a boot without one. His poses share one
# box with his feet at the same height (assets/wiz, rendered at build time by
# nix/packages/plymouth.nix), so a pose swaps in place. The box is 132 rig
# units high with his feet at 122; he stands centred on the field's top edge,
# below the logo. Without his pictures the field keeps its place under the logo.
wiz.asleep = Image("wiz-asleep.png");
wiz.listening = Image("wiz-listening.png");
wiz.sorry = Image("wiz-sorry.png");
wiz.happy = Image("wiz-happy.png");
wiz.sprite = Sprite();
wiz.sprite.SetOpacity(0);
if (wiz.asleep && wiz.listening && wiz.sorry && wiz.happy)
  {
    wiz.feet = Math.Int(wiz.asleep.GetHeight() * 122 / 132);
    # Space between the logo and the field: his box, from its top to his feet.
    global.entry_gap = 16 + wiz.feet;
  }
else
  {
    wiz.feet = 0;
    global.entry_gap = 40;
  }

entry.sprite = Sprite(entry.image);
entry.x = Window.GetWidth()/2 - entry.image.GetWidth() / 2;
entry.y = logo.sprite.GetY() + logo.image.GetHeight() + global.entry_gap;
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

# Bullet array
bullet.sprites = [];

# Wiz's pose follows the prompt:
#   asleep     the field is empty
#   listening  there are bullets, and while the answer is checked
#   sorry      systemd-cryptsetup asks again: the same prompt straight after an
#              answer means the passphrase was wrong (it sends no other sign)
#   happy      for two seconds once systemd reports a systemd-cryptsetup@ unit
#              started, which it does only when its disk unlocked
global.wiz_asking = 0;    # a password prompt is showing
global.wiz_checking = 0;  # a prompt was answered and no verdict came yet
global.wiz_prompt = "";   # the latest prompt's text
global.wiz_retry = 0;     # the showing prompt follows a wrong passphrase
global.wiz_frame = 0;     # refresh frames, 50 a second
global.wiz_until = 0;     # the frame at which he leaves; 0 while he stays

fun wiz_place ()
  {
    if (wiz.feet > 0)
      wiz.sprite.SetPosition(entry.x + entry.image.GetWidth() / 2 - wiz.asleep.GetWidth() / 2, entry.y - wiz.feet, 10003);
  }

fun wiz_show (image)
  {
    if (wiz.feet > 0)
      {
        wiz.sprite.SetImage(image);
        wiz_place();
        wiz.sprite.SetOpacity(1);
      }
  }

fun wiz_hide ()
  {
    wiz.sprite.SetOpacity(0);
    global.wiz_until = 0;
  }

fun display_normal_callback ()
  {
    update_layout();
    hide_password_dialog();

    # An answered prompt: Wiz keeps listening while the passphrase is checked,
    # and leaves after 30 seconds should no verdict arrive.
    if (global.wiz_asking == 1)
      {
        global.wiz_asking = 0;
        global.wiz_checking = 1;
        global.wiz_until = global.wiz_frame + 1500;
      }

    # Get current mode
    mode = Plymouth.GetMode();

    # Only show progress bar for boot and resume modes
    if ((mode == "boot" || mode == "resume") && global.password_shown == 1)
      {
        show_progress_bar();
        start_fake_progress();
      }
  }

fun display_password_callback (prompt, bullets)
  {
    update_layout();
    global.password_shown = 1;  # Mark that password dialog has been shown

    # Reset progress when password dialog appears
    global.medium_active = 0;
    stop_fake_progress();
    hide_progress_bar();
    global.max_progress = 0.0;
    global.fake_progress = 0.0;
    global.real_progress = 0.0;
    show_password_dialog();

    # Clear all bullets first
    for (index = 0; bullet.sprites[index]; index++)
      bullet.sprites[index].SetOpacity(0);

    # Create and show bullets for current password (max 21)
    max_bullets = 21;
    bullets_to_show = bullets;
    if (bullets_to_show > max_bullets)
      bullets_to_show = max_bullets;

    for (index = 0; index < bullets_to_show; index++)
      {
        if (!bullet.sprites[index])
          {
            # Scale bullet image to 7x7 pixels
            scaled_bullet = bullet.image.Scale(7, 7);
            bullet.sprites[index] = Sprite(scaled_bullet);
            bullet.x = entry.x + 20 + index * (7 + 5);
            bullet.y = entry.y + entry.image.GetHeight() / 2 - 3.5;
            bullet.sprites[index].SetPosition(bullet.x, bullet.y, 10002);
          }
        bullet.sprites[index].SetOpacity(1);
      }

    # Wiz comes last, so a fault in his part cannot hide the field.
    if (global.wiz_asking == 0)
      {
        global.wiz_retry = 0;
        if (global.wiz_checking == 1 && prompt == global.wiz_prompt)
          global.wiz_retry = 1;
        global.wiz_asking = 1;
        global.wiz_checking = 0;
        global.wiz_prompt = prompt;
      }
    global.wiz_until = 0;
    if (bullets > 0)
      wiz_show(wiz.listening);
    else if (global.wiz_retry == 1)
      wiz_show(wiz.sorry);
    else
      wiz_show(wiz.asleep);
  }

# systemd sends the name of each unit that has started.
fun update_status_callback (status)
  {
    if (global.medium_active == 1)
      medium_status(status);

    if (global.wiz_checking == 1 && String(status).SubString(0, 19) == "systemd-cryptsetup@")
      {
        global.wiz_checking = 0;
        wiz_show(wiz.happy);
        global.wiz_until = global.wiz_frame + 100;
      }
  }

#----------------------------------------- Progress Bar --------------------------------

progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);

progress_box.x = Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = entry.y + entry.image.GetHeight() / 2 - progress_box.image.GetHeight() / 2;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);
progress_box.sprite.SetOpacity(0);

progress_bar.original_image = Image("progress_bar.png");
progress_bar.sprite = Sprite();
progress_bar.image = progress_bar.original_image.Scale(1, progress_bar.original_image.GetHeight());

progress_bar.x = Window.GetWidth() / 2 - progress_bar.original_image.GetWidth() / 2;
progress_bar.y = progress_box.y + (progress_box.image.GetHeight() - progress_bar.original_image.GetHeight()) / 2;
progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 1);
progress_bar.sprite.SetOpacity(0);

# Plymouth starts on the firmware framebuffer before xe exposes the internal
# panel and the Apple display's two tiles. The script plugin then changes its
# global canvas and centers every display inside it. Recenter the sprites when
# that geometry changes so the LUKS prompt cannot remain outside a display.
fun update_layout ()
  {
    new_width = Window.GetWidth();
    new_height = Window.GetHeight();

    if (new_width <= 0 || new_height <= 0)
      return;

    if (new_width == global.layout_width && new_height == global.layout_height)
      return;

    global.layout_width = new_width;
    global.layout_height = new_height;

    logo.x = new_width / 2 - logo.image.GetWidth() / 2;
    logo.y = new_height * 0.38 - logo.image.GetHeight() / 2;
    logo.sprite.SetX(logo.x);
    logo.sprite.SetY(logo.y);

    entry.x = new_width / 2 - entry.image.GetWidth() / 2;
    entry.y = logo.y + logo.image.GetHeight() + global.entry_gap;
    entry.sprite.SetPosition(entry.x, entry.y, 10001);
    wiz_place();

    for (index = 0; bullet.sprites[index]; index++)
      {
        bullet.x = entry.x + 20 + index * (7 + 5);
        bullet.y = entry.y + entry.image.GetHeight() / 2 - 3.5;
        bullet.sprites[index].SetPosition(bullet.x, bullet.y, 10002);
      }

    progress_box.x = new_width / 2 - progress_box.image.GetWidth() / 2;
    progress_box.y = entry.y + entry.image.GetHeight() / 2 - progress_box.image.GetHeight() / 2;
    progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);

    progress_bar.x = new_width / 2 - progress_bar.original_image.GetWidth() / 2;
    progress_bar.y = progress_box.y + (progress_box.image.GetHeight() - progress_bar.original_image.GetHeight()) / 2;
    progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 1);
  }

fun progress_callback (duration, progress)
  {
    # Plymouth's own estimate learns from earlier boots, which a medium lacks.
    if (global.medium_active == 1)
      return;

    global.real_progress = progress;

    # If real progress is above limit, stop fake progress and use real progress
    if (progress > global.fake_progress_limit)
      {
        stop_fake_progress();
        update_progress_bar(progress);
      }
  }

#----------------------------------------- Installation medium --------------------------------

# The medium boots for longer than an installed system, longest from a network
# or a slow USB stick, and has no earlier boot to estimate from. Its bar shows
# from the first frame and follows the medium's own milestones in boot order:
# systemd reports each unit that has started, and cybexos-installer-splash
# reports cybexos-installer-ready just before the installer screen takes over
# the display (nix/modules/installer.nix). Between two milestones the bar
# eases towards the next without reaching it; it never moves back.
medium.units = [];
medium.marks = [];
medium.units[0] = "sysroot-iso.mount";             medium.marks[0] = 0.25;  # the medium is found
medium.units[1] = "sysroot-nix-store.mount";       medium.marks[1] = 0.4;   # its store is mounted
medium.units[2] = "systemd-journal-flush.service"; medium.marks[2] = 0.55;  # the system has started
medium.units[3] = "NetworkManager.service";        medium.marks[3] = 0.7;
medium.units[4] = "cybexos-installerd.service";    medium.marks[4] = 0.85;
medium.units[5] = "cybexos-installer-ready";       medium.marks[5] = 1;
global.medium_active = 0;    # the bar follows the medium's boot
global.medium_reached = -1;  # the latest milestone reached
global.medium_since = 0;     # the frame it was reached
global.medium_frame = 0;     # refresh frames, 50 a second
global.medium_shown = 0;     # the bar as drawn

fun medium_status (status)
  {
    for (index = global.medium_reached + 1; medium.units[index]; index++)
      if (status == medium.units[index])
        {
          global.medium_reached = index;
          global.medium_since = global.medium_frame;
        }
  }

fun medium_refresh ()
  {
    global.medium_frame++;
    floor = 0;
    if (global.medium_reached >= 0)
      floor = medium.marks[global.medium_reached];
    ahead = medium.marks[global.medium_reached + 1];
    if (!ahead)
      ahead = 1;

    # Halfway to the next milestone after four seconds.
    seconds = (global.medium_frame - global.medium_since) / 50;
    goal = floor + (ahead - floor) * seconds / (seconds + 4);

    # The bar fills within a quarter of a second after the last milestone,
    # before the display changes hands.
    if (floor == 1)
      global.medium_shown += (1 - global.medium_shown) / 3;
    else
      global.medium_shown += (goal - global.medium_shown) / 6;
    if (global.medium_shown > 0.99)
      global.medium_shown = 1;
    update_progress_bar(global.medium_shown);
  }

#----------------------------------------- Quit --------------------------------

fun quit_callback ()
{
  logo.sprite.SetOpacity (1);
}

#----------------------------------------- Message --------------------------------

message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10000);

fun display_message_callback (text)
{
  my_image = Image.Text(text, 1, 1, 1);
  message_sprite.SetImage(my_image);
}

fun hide_message_callback (text)
{
  message_sprite.SetOpacity(0);
}

update_layout();
# Shutdown and restart show only the logo.
if (global.installation_medium && Plymouth.GetMode() == "boot")
  {
    global.medium_active = 1;
    show_progress_bar();
  }
Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetUpdateStatusFunction(update_status_callback);
Plymouth.SetBootProgressFunction(progress_callback);
Plymouth.SetQuitFunction(quit_callback);
Plymouth.SetDisplayMessageFunction (display_message_callback);
Plymouth.SetHideMessageFunction (hide_message_callback);
