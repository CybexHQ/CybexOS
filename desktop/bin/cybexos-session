#!/usr/bin/env bash
set -euo pipefail
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM=wayland XMODIFIERS=@im=ibus
export CYBEXOS_USER_CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/cybexos"
export CYBEXOS_PLUGIN_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/cybexos/plugins"
# The pointer chosen in Settings -> Appearance (scripts/pointer.py), before
# Hyprland starts, so it draws that pointer from the first frame and every
# application inherits it. Only these two names, with plain values, are taken.
pointer_env="${XDG_STATE_HOME:-$HOME/.local/state}/cybexos/pointer/session.env"
if [[ -r $pointer_env ]]; then
  while IFS='=' read -r name value || [[ -n $name ]]; do
    if [[ $name == XCURSOR_THEME && $value =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,79}$ ]]; then
      export XCURSOR_THEME="$value"
    elif [[ $name == XCURSOR_SIZE && $value =~ ^[0-9]{2,3}$ ]] && (( 10#$value >= 16 && 10#$value <= 128 )); then
      export XCURSOR_SIZE="$value"
    fi
  done < "$pointer_env"
fi
# SDDM must get control again after a compositor crash.
trap 'systemctl --user stop hyprland-session.target' EXIT
Hyprland --config /etc/cybexos/runtime/hypr/hyprland.lua "$@"
