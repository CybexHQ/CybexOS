#!/usr/bin/env bash
# Screenshots with Omasnap (docs/keyboard-shortcuts.md#capture).
# Usage: screenshot [region|window|fullscreen|scroll] [OMASNAP OPTIONS...]
#   region      the default: drag out a region, click a window for just that
#               window, or click outside every window for the whole screen
#   window      start by choosing a window
#   fullscreen  the focused screen at once: saved, copied and announced
#   scroll      select a region, then scroll it into one tall image
# A capture is saved in ~/Pictures/Screenshots and copied, and a preview
# offers to copy it again, drag it into an app, pin it or edit it. Running
# this again while the overlay is open closes the overlay.
set -euo pipefail

mode=${1:-region}
(($# == 0)) || shift
case $mode in
  region) exec omasnap smart "$@" ;;
  window) exec omasnap windows "$@" ;;
  fullscreen) exec omasnap fullscreen --copy --save "$@" ;;
  scroll) exec omasnap scroll "$@" ;;
  *)
    printf 'Usage: screenshot [region|window|fullscreen|scroll]\n' >&2
    exit 2
    ;;
esac
