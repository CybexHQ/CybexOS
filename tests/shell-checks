#!/usr/bin/env bash
# QML lint and the shell's runtime tests, for a change to the Quickshell config.
#
# The lint and the two runtime tests run side by side (tests/checks.bash).
# Each runtime test starts its Quickshell with a home, runtime directory,
# session bus and compositor of its own, so neither waits for the other, nor
# for another test's shell (the regression step's, a second run's).
set -uo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." || exit 2

source tests/checks.bash

check tests/qml-lint tests/qml-lint
check tests/user-plugins.py python3 -B tests/user-plugins.py
check tests/media-player.py python3 -B tests/media-player.py
run_checks tests/shell-checks
