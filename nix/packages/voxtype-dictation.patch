+/// Path of the live preview for a streamed transcript.
+///
+/// A file-output streaming session types nothing while it runs, so this
+/// sibling carries the running text (committed segments plus the current
+/// partial) for a client that draws its own dictation UI.
+pub fn live_preview_path(transcript: &std::path::Path) -> std::path::PathBuf {
+    let mut live = transcript.as_os_str().to_os_string();
+    live.push(".live");
+    std::path::PathBuf::from(live)
+}
+
+/// Replace the live preview atomically, so a reader never sees half a write.
+fn write_live_preview(transcript: &std::path::Path, text: &str) {
+    let live = live_preview_path(transcript);
+    let staged = temp_sibling(&live);
+    if std::fs::write(&staged, text).is_err() {
+        let _ = std::fs::remove_file(&staged);
+        return;
+    }
+    if std::fs::rename(&staged, &live).is_err() {
+        let _ = std::fs::remove_file(&staged);
+    }
+}
+
+/// Publish a file-output streaming session's running text.
+fn publish_live_preview(state: &State, session: &StreamingSession) {
+    if let State::Streaming {
+        file_output_path: Some(path),
+        ..
+    } = state
+    {
+        let mut text = session.finalized_text().to_string();
+        text.push_str(session.partial());
+        write_live_preview(path, &text);
+    }
+}
+
