#!/usr/bin/env python3
import json
import os
from pathlib import Path
import subprocess
import sys
from cybexos.common import read
from cybexos.health import (USER_UNIT, baseline, desktop, desktop_sessions, preexisting_arguments, reported,
                            system_services, user_services)


def run(*argv):
    return subprocess.check_output(argv, text=True, stderr=subprocess.STDOUT).strip()


try:
    mode = sys.argv[1]
    declaration = read('/etc/cybexos/health-services.json')
    if mode == 'baseline':
        # What the running system already lacks, recorded before the updater changes it.
        print(json.dumps(baseline(run, declaration, desktop_sessions(run, Path('/run/user')))))
    elif mode == 'report':
        # Optional units that are not running: shown, never rejected.
        print(json.dumps(reported(run, declaration, desktop_sessions(run, Path('/run/user')))))
    elif mode == 'system':
        system_services(run, declaration, preexisting_arguments(sys.argv[2:]))
        if not Path('/run/booted-system').exists():
            raise ValueError('Booted system identity missing')
    elif mode in ('desktop', 'desktop-required'):
        preexisting = preexisting_arguments(sys.argv[2:], USER_UNIT)
        sessions = desktop_sessions(run, Path('/run/user'))
        for _, prefix in sessions:
            user_services(prefix, run, declaration, preexisting)
            guard = os.environ['CYBEXOS_UPDATER_SHARE'] + '/lib/quickshell-live'
            expected = read(Path(os.environ['CYBEXOS_UPDATER_SHARE']) / 'desktop-runtime.json') if mode == 'desktop-required' else None
            desktop(prefix, run, guard, expected)
        if not sessions and mode == 'desktop-required':
            raise ValueError('No authenticated Cybex OS desktop session. Sign in before confirming.')
    else:
        raise ValueError('Unknown health mode: ' + mode)
except Exception as error:
    print(str(error), file=sys.stderr)
    sys.exit(1)
