def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


def zoneinfo_root():
    for candidate in (os.environ.get('TZDIR'), '/etc/zoneinfo', '/usr/share/zoneinfo'):
        if candidate and (Path(candidate) / 'zone.tab').is_file():
            return Path(candidate)
    return None


def parse_coordinate(text):
    split = max(text.rfind('+'), text.rfind('-'))
    def convert(value, degree_digits):
        sign = -1 if value[0] == '-' else 1
        digits = value[1:]
        degrees, minutes = int(digits[:degree_digits]), int(digits[degree_digits:degree_digits + 2])
        seconds = int(digits[degree_digits + 2:] or 0)
        return round(sign * (degrees + minutes / 60 + seconds / 3600), 2)
    return convert(text[:split], 2), convert(text[split:], 3)


def timezone_table(root=None):
    """User-facing zones from the medium's own tzdata.

    zone.tab keeps one familiar entry per country, so Europe/Amsterdam stays
    listed even where tzdata merges its data with Brussels. Backward links
    become search aliases (Kiev -> Kyiv). The installed system uses the same
    tzdata, because both are built from the one tested Nixpkgs revision.
    """
    root = root or zoneinfo_root()
    if root is None:
        return {'zones': [['UTC', '', 0, 0, '']], 'countries': {}, 'aliases': {}, 'tzdata': 'unavailable'}
    countries = {}
    for line in (root / 'iso3166.tab').read_text(encoding='utf-8').splitlines():
        if line and not line.startswith('#') and '\t' in line:
            code, name = line.split('\t', 1)
            countries[code] = name
    zones = []
    for line in (root / 'zone.tab').read_text(encoding='utf-8').splitlines():
        if not line or line.startswith('#'):
            continue
        parts = line.split('\t')
        if len(parts) < 3 or not (root / parts[2]).is_file():
            continue
        latitude, longitude = parse_coordinate(parts[1])
        zones.append([parts[2], parts[0], latitude, longitude, parts[3] if len(parts) > 3 else ''])
    known = {zone[0] for zone in zones}
    aliases, version = {}, 'unknown'
    data = root / 'tzdata.zi'
    if data.is_file():
        for line in data.read_text(encoding='utf-8').splitlines():
            if line.startswith('# version '):
                version = line.removeprefix('# version ').strip()
            elif line.startswith('L '):
                fields = line.split()
                if len(fields) == 3 and fields[1] in known and '/' in fields[2] \
                        and not fields[2].startswith(('Etc/', 'SystemV/')):
                    aliases[fields[2]] = fields[1]
    return {'zones': zones, 'countries': countries, 'aliases': aliases, 'tzdata': version}


def canonical_zone(zone, table):
    known = {entry[0] for entry in table['zones']}
    if zone in known or zone == 'UTC' or re.fullmatch(r'Etc/GMT[+-](?:[1-9]|1[0-4])', zone or ''):
        return zone
    return table['aliases'].get(zone)


def hostname_for(username):
    suffix = '-cybexos'
    return (username[:31 - len(suffix)] + suffix) if username else 'cybexos'


def username_problem(name, reserved):
    if not NAME.fullmatch(name or ''):
        return 'Choose a username: lowercase letters, digits and hyphens, starting with a letter.'
    if name in reserved:
        return f'“{name}” is reserved by the system. Choose another username.'
    return ''


def hostname_problem(name, reserved):
    if not NAME.fullmatch(name or ''):
        return 'Use a computer name of lowercase letters, digits and hyphens, starting with a letter.'
    if name in ('root', 'nixos'):
        return 'Choose a computer name other than root or nixos.'
    return ''


FULL_NAME_FORBIDDEN = set(':,\\"$`')


def full_name_problem(name):
    # Mirrors the worker: the name becomes a GECOS field and a Nix string.
    if len(name) > 64 or any(ord(c) < 32 or ord(c) == 127 or c in FULL_NAME_FORBIDDEN for c in name):
        return 'Your name may not contain : , \\ " $ ` or control characters (64 characters at most).'
    return ''


def software_include(item, directory):
    """What a profile brings besides its apps, such as Docker. An id names its icon."""
    icon = directory / 'icons' / f'{item["id"]}.png' if isinstance(item.get('id'), str) and ID.fullmatch(item['id']) else None
    return {'name': item['name'][:64], 'icon': str(icon) if icon and icon.is_file() else ''}


def software_catalogue(directory=None):
    """The software profiles and their apps, from the release's catalogue.

    The catalogue is release data, generated by scripts/software-catalogue.
    Entries the installer could not offer safely are left out rather than
    trusted. The medium carries the default profiles' free apps
    (nix/modules/installer-payload.nix), so those install without a download.
    """
    directory = Path(directory or SOFTWARE)
    data = read_json(directory / 'catalogue.json', {})
    data = data if isinstance(data, dict) else {}
    apps = {}
    for app in data.get('apps') or []:
        if (isinstance(app, dict) and isinstance(app.get('id'), str) and ID.fullmatch(app['id'])
                and isinstance(app.get('attribute'), str) and len(app['attribute']) <= 200
                and ATTRIBUTE.fullmatch(app['attribute'])):
            icon = directory / 'icons' / f'{app["id"]}.png'
            size = app.get('downloadBytes')
            apps[app['id']] = {'id': app['id'], 'attribute': app['attribute'], 'name': str(app.get('name') or app['id'])[:64],
                               'free': app.get('free') is not False, 'icon': str(icon) if icon.is_file() else '',
                               'downloadBytes': size if type(size) is int and size >= 0 else 0}
    profiles = []
    for profile in data.get('profiles') or []:
        if not isinstance(profile, dict) or not isinstance(profile.get('id'), str) or not ID.fullmatch(profile['id']):
            continue
        members = [app for app in profile.get('apps') or [] if app in apps]
        features = profile.get('features') if isinstance(profile.get('features'), dict) else {}
        size = profile.get('downloadBytes')
        profiles.append({
            'id': profile['id'], 'name': str(profile.get('name') or profile['id'])[:64],
            'short': str(profile.get('short') or profile.get('name') or profile['id'])[:32],
            'summary': str(profile.get('summary') or '')[:120], 'icon': str(profile.get('icon') or '')[:64],
            'default': profile.get('default') is True, 'onMedium': profile.get('default') is True,
            'includes': [software_include(item, directory) for item in profile.get('includes') or []
                         if isinstance(item, dict) and isinstance(item.get('name'), str)][:12],
            'apps': list(dict.fromkeys(members)),
            'features': sorted(key for key, value in features.items() if key in FEATURES and value is True),
            'downloadBytes': size if type(size) is int and size >= 0 else 0})
    for profile in profiles:
        # Apps and software that come from their vendors under unfree licenses.
        profile['vendor'] = (sum(not apps[app]['free'] for app in profile['apps'])
                             + sum(key in UNFREE_FEATURES for key in profile['features']))
    return {'profiles': profiles, 'apps': apps}


def firmware_facts():
    efi = Path('/sys/firmware/efi').exists()
    secure = False
    with contextlib.suppress(OSError):
        secure = any(p.read_bytes()[-1:] == b'\x01' for p in Path('/sys/firmware/efi/efivars').glob('SecureBoot-*'))
    return {'uefi': efi, 'secureBoot': secure}


def memory_bytes():
    with contextlib.suppress(OSError, ValueError, IndexError):
        for line in Path('/proc/meminfo').read_text().splitlines():
            if line.startswith('MemTotal:'):
                return int(line.split()[1]) * 1024
    return 0


def graphics_names():
    try:
        output = subprocess.run(['lspci', '-mm'], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    names = []
    for line in output.splitlines():
        fields = re.findall(r'"([^"]*)"', line)
        if len(fields) >= 3 and fields[0] in ('VGA compatible controller', '3D controller', 'Display controller'):
            vendor = re.sub(r'\b(Corporation|Corp\.|Inc\.|\[AMD/ATI\]|Advanced Micro Devices, Inc\.)', '', fields[1]).strip(' ,')
            device = fields[2].split('[')[-1].rstrip(']') if '[' in fields[2] else fields[2]
            names.append((vendor + ' ' + device).strip()[:80])
    return names


class Daemon:
    def __init__(self, worker_args=(), network_helper=None, python=sys.executable):
        self.worker_args = list(worker_args)
        self.network_helper = network_helper or os.environ.get('CYBEXOS_NETWORK_HELPER', '')
        self.python = python
        self.clients = set()
        # Connections whose hello identified the installer screen. Snapshots
        # report the count so automation can wait until the screen is attached.
        self.screens = set()
        self.worker = None
        self.worker_task = None
        self.password = ''
        self.token = ''
        self.reviewed = None
        self.review_pending = False
        self.started_at = None
        self.catalogue = software_catalogue()
        self.static = self.static_data(self.catalogue)
        self.reserved = set(self.static['reserved'])
        defaults = self.static['defaults']
        # The default profiles' system features follow their selection.
        chosen = [p['id'] for p in self.catalogue['profiles'] if p['default']]
        region = read_json(ETC / 'installer-region.json', {}) or {}
        layout = region.get('desktopKeyboard') if region.get('desktopKeyboard') in {l[0] for l in LAYOUTS} else 'us'
        locale = region.get('locale') if region.get('locale') in {l[0] for l in LANGUAGES} else 'en_US.UTF-8'
        saved = read_json(RUNTIME / 'draft.json', {}) or {}
        self.nvidia_edited = saved.get('nvidiaEdited') is True
        self.draft = {'screen': 'welcome', 'disk': '', 'encrypted': True, 'fullName': '', 'username': '',
                      'userEdited': False, 'hostname': '', 'hostEdited': False,
                      'timezone': canonical_zone(region.get('timezone', 'UTC'), self.static) or 'UTC',
                      'tzSource': 'default', 'locale': locale, 'layout': layout,
                      'profiles': chosen, 'appsOff': [],
                      'features': {key: defaults[key] and (key in self.provided(chosen) or key not in self.provided())
                                   for key, _, _ in SYSTEM_FEATURES},
                      'nvidiaOpen': True}
        # A daemon restart keeps the non-secret draft from this boot only.
        for key, value in (saved.get('draft') or {}).items():
            self.apply_draft_value(key, value)
        self.state = {'phase': 'loading', 'message': 'Checking this installation medium…', 'error': '',
                      'stage': 0, 'stages': STAGES, 'elapsed': 0, 'release': '', 'development': False,
                      'disks': [], 'hardware': detect(), 'network': {'busy': False, 'error': '', 'message': ''},
                      'region': {'busy': False, 'message': '', 'detected': ''},
                      'firmware': firmware_facts(), 'memory': memory_bytes(), 'graphics': graphics_names(),
                      'review': None, 'result': None, 'diskTouched': False}
        self.region_attempted = False
        self.region_task = None
        self.network_task = None
        self.pending_network = None
        self.pending_push = None
        self.persisted_draft = None
        self.queries = {}

    # ── static data ──────────────────────────────────────────────────────────
    def static_data(self, catalogue=None):
        defaults = read_json(ETC / 'installer-defaults.json', {}) or {}
        catalogue = catalogue or software_catalogue()
        layout = read_json(ETC / 'installer-layout.json', {}) or {}
        reserved = read_json(ETC / 'installer-reserved-names.json', []) or []
        release = read_json(ETC / 'release.json', {}) or {}
        table = timezone_table()
        return {'type': 'static', 'schema': SCHEMA, **table,
                'layouts': [list(entry) for entry in LAYOUTS], 'languages': [list(entry) for entry in LANGUAGES],
                'features': [list(entry) for entry in SYSTEM_FEATURES],
                'defaults': {key: bool(defaults.get(key, True)) for key in FEATURES},
                'software': {'profiles': catalogue['profiles'],
                             'apps': {key: {field: app[field] for field in ('name', 'free', 'icon', 'downloadBytes')}
                                      for key, app in catalogue['apps'].items()
                                      if any(key in profile['apps'] for profile in catalogue['profiles'])}},
                'reserved': sorted({'root', 'nixos', *[name for name in reserved if isinstance(name, str)]}),
                # The installer shows the release without its prerelease suffix.
                'version': str(release.get('version', '')).partition('-')[0], 'layout': layout}

    # ── snapshots ────────────────────────────────────────────────────────────
    def snapshot(self):
        state = dict(self.state)
        if self.started_at is not None and state['phase'] == 'installing':
            state['elapsed'] = int(time.monotonic() - self.started_at)
        return {'type': 'state', 'schema': SCHEMA, **state, 'draft': self.draft, 'software': self.software()['summary'],
                'reviewPending': self.review_pending, 'screens': len(self.screens)}

    def update(self, **values):
        self.state.update(values)
        self.push()

    def push(self):
        # Coalesce bursts (worker events, typing) into one snapshot per tick.
        if self.pending_push is None:
            self.pending_push = asyncio.get_running_loop().call_soon(self.flush)

    def flush(self):
        self.pending_push = None
        self.send_all(self.snapshot())
        draft = json.dumps({'draft': self.draft, 'nvidiaEdited': self.nvidia_edited})
        if draft == self.persisted_draft:
            return
        with contextlib.suppress(OSError):
            RUNTIME.mkdir(parents=True, exist_ok=True)
            temporary = RUNTIME / 'draft.json.tmp'
            temporary.write_text(draft)
            os.replace(temporary, RUNTIME / 'draft.json')
            self.persisted_draft = draft

    def send_all(self, message):
        if not self.clients:
            return
        data = self.encode(message)
        for client in list(self.clients):
            self.send_bytes(client, data)

    def send(self, writer, message):
        self.send_bytes(writer, self.encode(message))

    @staticmethod
    def encode(message):
        return (json.dumps(message, ensure_ascii=False, separators=(',', ':')) + '\n').encode()

    def send_bytes(self, writer, data):
        try:
            writer.write(data)
        except (OSError, RuntimeError):
            self.clients.discard(writer)
            self.screens.discard(writer)

    # ── worker ───────────────────────────────────────────────────────────────
    async def start_worker(self):
        if self.worker is not None and self.worker.returncode is None:
            return
        self.password, self.token, self.reviewed, self.review_pending = '', '', None, False
        self.started_at = None
        self.update(phase='loading', message='Checking this installation medium…', error='', stage=0,
                    review=None, result=None, diskTouched=False)
        self.worker = await asyncio.create_subprocess_exec(
            'cybexos-install', '--json-ui', *self.worker_args,
            stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL, limit=MAX_LINE)
        self.worker_task = asyncio.create_task(self.read_worker(self.worker))

    async def read_worker(self, process):
        while True:
            try:
                line = await process.stdout.readline()
            except (ValueError, asyncio.LimitOverrunError):
                continue
            if not line:
                break
            try:
                value = json.loads(line)
            except (ValueError, UnicodeError):
                continue  # Human completion text is not the protocol.
            if isinstance(value, dict) and isinstance(value.get('event'), str):
                self.handle_event(value)
        await process.wait()
        if process is self.worker:
            self.worker_exited()

    def worker_send(self, request):
        if self.worker is None or self.worker.returncode is not None or self.worker.stdin is None:
            raise Failure('The installation worker is not running. Start over to try again.')
        self.worker.stdin.write((json.dumps(request) + '\n').encode())

    def worker_exited(self):
        self.password = ''
        if self.state['phase'] not in ('complete', 'error', 'cancelled'):
            message = ('The installation worker stopped. Your disk may have been changed. See the installation details.'
                       if self.state['diskTouched'] else 'The installation worker stopped before changing any disk.')
            self.update(phase='error', error=message)

    def handle_event(self, value):
        kind = value['event']
        if kind == 'network':
            self.state['network'] = {**self.state['network'], 'message': str(value.get('message', ''))[:200]}
            self.push()
        elif kind == 'development-required':
            self.update(phase='development', message=str(value.get('message', '')), error='')
        elif kind == 'preflight-error':
            self.update(phase='preflight', error=str(value.get('message', ''))[:600])
        elif kind == 'ready':
            disks = [self.disk_view(disk) for disk in value.get('disks', []) if isinstance(disk, dict)]
            self.state.update(disks=disks, hardware=value.get('hardware') or {}, release=str(value.get('release', ''))[:300],
                              development=bool(value.get('development')))
            recommended = self.state['hardware'].get('nvidiaOpen')
            if not self.nvidia_edited and type(recommended) is bool:
                self.draft['nvidiaOpen'] = recommended
            available = [disk['path'] for disk in disks if disk['available']]
            if self.draft['disk'] not in available:
                self.draft['disk'] = available[0] if len(available) == 1 else ''
            if self.state['phase'] in ('loading', 'preflight', 'development'):
                self.state['phase'] = 'setup'
            self.update(error='')
            if not self.region_attempted:
                self.start_region()
        elif kind == 'validation-error':
            self.review_pending = False
            self.token, self.reviewed = '', None
            self.update(phase='setup', review=None, error=str(value.get('message', ''))[:600])
        elif kind == 'review':
            self.review_pending = False
            self.reviewed, self.token = value.get('plan'), str(value.get('token', ''))
            self.update(phase='review', review=self.public_plan(self.reviewed), error='')
        elif kind == 'started':
            self.started_at = time.monotonic()
            self.update(phase='installing', message='Preparing installation…', error='', stage=0)
        elif kind == 'disk-writing':
            self.update(diskTouched=True)
        elif kind in ('stage', 'activity'):
            stage = value.get('stage', self.state['stage'])
            self.update(message=str(value.get('message', ''))[:200], stage=stage if isinstance(stage, int) else self.state['stage'])
        elif kind == 'complete':
            self.password = ''
            result = {key: value.get(key) for key in ('username', 'hostname', 'encrypted')}
            elapsed = int(time.monotonic() - self.started_at) if self.started_at is not None else self.state['elapsed']
            self.update(phase='complete', result=result, error='', stage=STAGES, elapsed=elapsed)
        elif kind == 'error':
            self.password = ''
            message = str(value.get('message', ''))[:600]
            if 'Another installer is running' in message:
                # This service restarted while an installation it started
                # keeps running (KillMode=process); its log shows progress.
                message = ('An installation that started before this screen restarted is still running. '
                           'Follow it under Installation details, and restart when it has finished.')
            self.update(phase='error', error=message)
        elif kind == 'cancelled':
            self.password = ''
            self.update(phase='cancelled', error='')

    @staticmethod
    def disk_view(disk):
        path = str(disk.get('path', ''))
        bus = 'NVMe' if '/nvme' in path else 'Virtual' if '/vd' in path else 'Disk'
        if '/mmcblk' in path:
            # The MMC core reports built-in eMMC as MMC and a card in a reader as SD.
            try:
                kind = Path(f'/sys/block/{Path(path).name}/device/type').read_text().strip()
            except OSError:
                kind = ''
            bus = 'SD card' if kind == 'SD' else 'eMMC'
        return {'path': path, 'serial': str(disk.get('serial') or ''),
                # What the plan carries for the disk check: the serial, else the
                # WWN or device path for disks without one (cybexos-install).
                'identity': str(disk.get('identity') or disk.get('serial') or '')[:256],
                'model': str(disk.get('model') or '').strip()[:80], 'size': int(disk.get('size') or 0),
                'available': bool(disk.get('available')), 'reason': str(disk.get('reason') or '')[:200],
                'filesystems': [str(f) for f in disk.get('filesystems') or []][:8], 'bus': bus}

    @staticmethod
    def public_plan(plan):
        if not isinstance(plan, dict):
            return None
        return {key: plan.get(key) for key in ('disk', 'serial', 'hostname', 'username', 'fullName', 'timezone',
                                               'locale', 'keyboard', 'desktopKeyboard', 'encrypted', 'autoLogin', 'nvidiaOpen',
                                               'features', 'software')}

    # ── software ─────────────────────────────────────────────────────────────
    def provided(self, profiles=None):
        """The features the given profiles switch on (all profiles by default)."""
        return {key for profile in self.catalogue['profiles'] if profiles is None or profile['id'] in profiles
                for key in profile['features']}

    def software(self):
        """What the draft installs, and its summary for the screen.

        The selected profiles this medium can install now (offline, only those
        it carries), their apps minus those turned off and, without proprietary
        applications, minus the unfree ones. Features come from the profiles and
        the system feature switches; unfree features need proprietary too.
        """
        draft, apps = self.draft, self.catalogue['apps']
        online = bool(self.state['network'].get('connected'))
        toggles = draft['features']
        proprietary = toggles.get('proprietary', True)
        chosen = [p for p in self.catalogue['profiles'] if p['id'] in draft['profiles'] and (p['onMedium'] or online)]
        members = list(dict.fromkeys(app for profile in chosen for app in profile['apps']))
        off = set(draft['appsOff'])
        installed = [app for app in members if app not in off and (apps[app]['free'] or proprietary)]
        provided, offered = self.provided([p['id'] for p in chosen]), self.provided()
        features = {}
        for key in FEATURES:
            if key in toggles:
                features[key] = toggles[key]
            elif key in offered:
                features[key] = key in provided
            else:
                features[key] = self.static['defaults'].get(key, True)
            if key in UNFREE_FEATURES and not proprietary:
                features[key] = False
        download = 0
        for profile in chosen:
            if profile['onMedium']:
                continue
            # A profile's estimate already counts the dependencies its apps
            # share; scale it by the share of its free apps that stay on.
            free = [app for app in profile['apps'] if apps[app]['free']]
            total = sum(apps[app]['downloadBytes'] for app in free)
            kept = sum(apps[app]['downloadBytes'] for app in free if app not in off)
            download += profile['downloadBytes'] if total == 0 else profile['downloadBytes'] * kept // total
        summary = {'profiles': [p['id'] for p in chosen], 'packages': len(installed), 'downloadBytes': download,
                   'appsOff': sum(app in off for app in members),
                   'withheld': sum(app not in off and not apps[app]['free'] and not proprietary for app in members),
                   'vendor': sum(not apps[app]['free'] for app in installed) + sum(features[key] for key in UNFREE_FEATURES),
                   'online': online}
        return {'packages': sorted(apps[app]['attribute'] for app in installed), 'features': features, 'summary': summary}

    def refresh_review(self):
        """Keep a shown review bound to what the draft installs now."""
        if self.state['phase'] == 'review' and not self.review_pending and self.password:
            with contextlib.suppress(Failure):
                if self.plan() != self.reviewed:
                    self.request_review()

    # ── plan ─────────────────────────────────────────────────────────────────
    def plan(self):
        draft = self.draft
        validate_hardware(self.state['hardware'], draft['nvidiaOpen'])
        disk = next((d for d in self.state['disks'] if d['path'] == draft['disk']), None)
        if disk is None or not disk['available']:
            raise Failure('Choose an available installation disk.')
        problem = username_problem(draft['username'], self.reserved)
        if problem:
            raise Failure(problem)
        hostname = draft['hostname'] if draft['hostEdited'] and draft['hostname'] else hostname_for(draft['username'])
        problem = hostname_problem(hostname, self.reserved) or full_name_problem(draft['fullName'].strip())
        if problem:
            raise Failure(problem)
        zone = canonical_zone(draft['timezone'], self.static)
        if zone is None:
            raise Failure('Choose a time zone from the list.')
        console = next(entry[2] for entry in LAYOUTS if entry[0] == draft['layout'])
        plan = {'disk': disk['path'], 'serial': disk['identity'], 'hostname': hostname, 'username': draft['username'],
                'timezone': zone, 'locale': draft['locale'], 'keyboard': console, 'desktopKeyboard': draft['layout'],
                'encrypted': bool(draft['encrypted']), 'autoLogin': bool(draft['encrypted']), 'secureBoot': False,
                'nvidiaOpen': bool(draft['nvidiaOpen'])}
        software = self.software()
        plan['features'] = software['features']
        plan['software'] = {'packages': software['packages']}
        if draft['fullName'].strip():
            plan['fullName'] = draft['fullName'].strip()
        return plan

    def request_review(self):
        plan = self.plan()
        self.review_pending = True
        self.token, self.reviewed = '', None
        self.worker_send({'action': 'review', 'plan': plan})
        self.push()

    # ── draft ────────────────────────────────────────────────────────────────
    def apply_draft_value(self, key, value):
        if key in DRAFT_STRINGS and isinstance(value, str) and len(value) <= DRAFT_STRINGS[key]:
            if key == 'screen' and value not in SCREENS:
                return False
            if key == 'layout' and value not in {entry[0] for entry in LAYOUTS}:
                return False
            if key == 'locale' and value not in {entry[0] for entry in LANGUAGES}:
                return False
            if key == 'timezone':
                value = canonical_zone(value, self.static)
                if value is None:
                    return False
            if key in ('username', 'hostname') and value and not re.fullmatch(r'[a-z][a-z0-9-]*', value):
                return False
            if key == 'fullName' and any(ord(c) < 32 for c in value):
                return False
            self.draft[key] = value
            return True
        if key in DRAFT_BOOLS and type(value) is bool:
            self.draft[key] = value
            return True
        if key == 'profiles' and isinstance(value, list) and len(value) <= 64:
            known = [profile['id'] for profile in self.catalogue['profiles']]
            if any(not isinstance(item, str) or item not in known for item in value):
                return False
            self.draft['profiles'] = [item for item in known if item in value]
            return True
        if key == 'appsOff' and isinstance(value, list) and len(value) <= 512:
            if any(not isinstance(item, str) or item not in self.catalogue['apps'] for item in value):
                return False
            self.draft['appsOff'] = sorted(set(value))
            return True
        if key == 'features' and isinstance(value, dict):
            for name, enabled in value.items():
                if name in self.draft['features'] and type(enabled) is bool:
                    self.draft['features'][name] = enabled
            return True
        return False

    def change_draft(self, values):
        before = self.provided(self.draft['profiles'])
        changed = [key for key, value in values.items() if self.apply_draft_value(key, value)]
        if 'nvidiaOpen' in changed:
            self.nvidia_edited = True
        if 'profiles' in changed and 'features' not in values:
            # A profile's system features follow it in and out (Development
            # brings Docker and Podman); a switch flipped later is kept, and
            # a change that sets the switches itself is taken as it is.
            after = self.provided(self.draft['profiles'])
            for key in self.draft['features']:
                if key in after - before or key in before - after:
                    self.draft['features'][key] = key in after
        if 'timezone' in changed and values.get('tzSource') is None:
            self.draft['tzSource'] = 'manual'
        plan_keys = set(changed) - {'screen', 'userEdited', 'hostEdited', 'tzSource'}
        if self.state['phase'] == 'review' and plan_keys:
            # Customizing on the review page re-reviews with the held password,
            # so the final click is always bound to exactly what is shown.
            try:
                self.request_review()
            except Failure as error:
                self.back()
                self.update(error=str(error))
                return
        if self.state['phase'] == 'setup' and plan_keys:
            self.state['error'] = ''
        self.push()

    def back(self):
        self.password, self.token, self.reviewed, self.review_pending = '', '', None, False
        self.draft['screen'] = 'software'
        self.update(phase='setup', review=None, error='')

    # ── requests ─────────────────────────────────────────────────────────────
    async def handle_request(self, writer, request):
        action = request.get('action')
        phase = self.state['phase']
        if action == 'hello':
            if request.get('client') == 'screen':
                self.screens.add(writer)
            self.send(writer, self.static)
            self.send(writer, self.snapshot())
        elif action == 'draft' and isinstance(request.get('values'), dict):
            if phase in ('loading', 'development', 'preflight', 'setup', 'review', 'cancelled'):
                self.change_draft(request['values'])
        elif action == 'development' and phase == 'development':
            self.update(phase='loading', message='Preparing the bundled test build…', error='')
            self.worker_send({'action': 'development', 'consent': True})
        elif action == 'retry' and phase == 'preflight':
            self.update(phase='loading', message='Checking this installation medium…', error='')
            self.worker_send({'action': 'retry'})
        elif action == 'rescan' and phase == 'setup':
            self.worker_send({'action': 'rescan'})
        elif action == 'review' and phase == 'setup':
            password, confirm = request.get('password'), request.get('confirm')
            try:
                if not isinstance(password, str) or not isinstance(confirm, str):
                    raise Failure('Enter your password twice.')
                validate_password(password)
                if password != confirm:
                    raise Failure('The two passwords do not match.')
                self.password = password
                self.request_review()
            except Failure as error:
                self.password = ''
                self.update(error=str(error))
        elif action == 'back' and phase == 'review':
            self.back()
        elif action == 'install' and phase == 'review' and self.token and not self.review_pending and self.password:
            secrets = {'password': self.password}
            self.worker_send({'action': 'install', 'token': self.token, 'confirmed': True, 'secrets': secrets})
            self.password, self.token = '', ''
            secrets.clear()
            self.update(phase='installing', message='Checking the selected disk…', error='', stage=0)
        elif action == 'start-over' and phase in ('error', 'cancelled'):
            if self.worker is not None and self.worker.returncode is None:
                with contextlib.suppress(Failure):
                    self.worker_send({'action': 'cancel'})
                with contextlib.suppress(asyncio.TimeoutError):
                    await asyncio.wait_for(self.worker.wait(), 5)
            self.draft['screen'] = 'welcome'
            await self.start_worker()
        elif action == 'keyboard' and request.get('layout') in {entry[0] for entry in LAYOUTS}:
            self.set_keyboard(request['layout'])
            self.send_all({'type': 'restart', 'reason': 'keyboard'})
        elif action == 'network-refresh':
            self.network('scan', None)
        elif action == 'network-connect' and isinstance(request.get('network'), dict):
            self.network('wifi', request['network'])
        elif action == 'detect-region':
            self.region_attempted = False
            self.start_region(manual=True)
        elif action == 'details':
            self.query(writer, 'details', self.details)
        elif action == 'usb-list':
            self.query(writer, 'usb', self.list_usb)
        elif action == 'usb-save' and isinstance(request.get('device'), str):
            self.send(writer, await asyncio.to_thread(save_log, request['device']))
        elif action == 'power' and request.get('kind') in ('reboot', 'poweroff', 'firmware'):
            if phase != 'installing':
                command = {'reboot': ['systemctl', 'reboot'], 'poweroff': ['systemctl', 'poweroff'],
                           'firmware': ['systemctl', 'reboot', '--firmware-setup']}[request['kind']]
                await run_quiet(command)
        elif action == 'shell':
            await run_quiet(['chvt', '2'])
        elif action == 'text-installer' and phase != 'installing':
            # The switch unit conflicts with this service; stopping it cancels
            # the idle worker (see shutdown), which releases the installer lock.
            await run_quiet(['systemctl', '--no-block', 'start', 'cybexos-installer-text-switch.service'])

    # ── keyboard ─────────────────────────────────────────────────────────────
    def set_keyboard(self, layout):
        self.draft['layout'] = layout
        # The screen re-reads this at its next start; the password it held is
        # gone, so it is retyped with the layout that will unlock the disk.
        RUNTIME.mkdir(parents=True, exist_ok=True)
        temporary = KEYBOARD_ENV.with_suffix('.tmp')
        temporary.write_text(f'XKB_DEFAULT_LAYOUT={layout}\n')
        temporary.chmod(0o644)
        os.replace(temporary, KEYBOARD_ENV)
        console = next(entry[2] for entry in LAYOUTS if entry[0] == layout)
        asyncio.get_running_loop().create_task(run_quiet(['loadkeys', console]))
        if self.state['phase'] == 'review':
            self.back()
        self.push()

    # ── network ──────────────────────────────────────────────────────────────
    def network(self, command, request):
        if self.network_task is not None and not self.network_task.done():
            # A user action must not disappear behind the periodic snapshot.
            # Keep at most one pending action, and release superseded secrets.
            if command != 'snapshot':
                if command == 'scan' and self.pending_network and self.pending_network[0] == 'wifi':
                    return
                if self.pending_network and self.pending_network[1]:
                    self.pending_network[1].clear()
                self.pending_network = (command, dict(request) if request else None)
            return
        self.network_task = asyncio.create_task(self.network_sequence(command, request))

    async def network_sequence(self, command, request):
        while True:
            self.state['network'] = {**self.state['network'], 'busy': True}
            if command != 'snapshot':
                self.state['network']['error'] = ''
            self.push()
            await self.run_network(command, request)
            if self.pending_network is not None:
                command, request = self.pending_network
                self.pending_network = None
            elif command != 'snapshot':
                command, request = 'snapshot', None
            else:
                return

    async def run_network(self, command, request):
        result = {'success': False, 'error': 'Network setup is unavailable on this medium.'}
        process = None
        payload = None
        if self.network_helper:
            helper_command = command
            if command in ('wifi', 'scan'):
                wifi = self.state['network'].get('wifi') or {}
                if command == 'wifi':
                    payload = {key: request.get(key) for key in ('ssid', 'security', 'password', 'identity', 'hidden', 'uuid', 'saved')}
                    payload.update(action='connect', interface=wifi.get('interface', ''))
                elif wifi.get('interface'):
                    payload = {'action': 'rescan', 'interface': wifi['interface']}
                else:
                    helper_command = 'snapshot'
                if payload is not None:
                    helper_command = 'wifi'
            try:
                process = await asyncio.create_subprocess_exec(
                    self.python, '-B', self.network_helper, helper_command, stdin=asyncio.subprocess.PIPE,
                    stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL, limit=MAX_LINE,
                    start_new_session=True)
                output, _ = await asyncio.wait_for(process.communicate(json.dumps(payload).encode() if payload else b''), 60)
                result = json.loads(output)
            except (OSError, ValueError, asyncio.TimeoutError):
                result = {'success': False, 'error': 'Network setup could not run. Retry, or use nmtui on the recovery shell.'}
            finally:
                if payload:
                    payload.clear()
                if request:
                    request.clear()
                if process is not None:
                    with contextlib.suppress(ProcessLookupError):
                        os.killpg(process.pid, signal.SIGKILL)
                    await process.wait()
        network = {**self.state['network'], 'busy': False}
        if not isinstance(result, dict) or not result.get('success'):
            error = result.get('error') if isinstance(result, dict) else None
            network['error'] = str(error or 'Connection failed. Check the password and retry.')[:300]
            self.state['network'] = network
            self.push()
            return
        if command == 'snapshot' or helper_command == 'snapshot':
            self.state['network'] = {**network, **summarize_network(result)}
            if self.state['network'].get('connected') and not network.get('connected'):
                self.state['network']['error'] = ''
            if bool(self.state['network'].get('connected')) != bool(network.get('connected')):
                # Offline, only the profiles this medium carries install.
                self.refresh_review()
            self.push()
            if self.state['network'].get('connected'):
                if not self.region_attempted:
                    self.start_region()
                if self.state['phase'] == 'preflight':
                    with contextlib.suppress(Failure):
                        self.update(phase='loading', message='Checking this installation medium…', error='')
                        self.worker_send({'action': 'retry'})
            return
        self.state['network'] = network
        self.push()

    async def watch_network(self):
        # NetworkManager can connect Ethernet at any time; keep the welcome
        # checks honest with a slow poll (no UI animation depends on it).
        while True:
            if self.network_task is None or self.network_task.done():
                self.network('snapshot', None)
            await asyncio.sleep(10 if self.state['network'].get('connected') else 4)

    # ── region ───────────────────────────────────────────────────────────────
    def start_region(self, manual=False):
        if self.region_task is not None and not self.region_task.done():
            return
        if manual and self.draft['tzSource'] == 'manual':
            self.draft['tzSource'] = 'default'
        self.region_attempted = True
        self.state['region'] = {**self.state['region'], 'busy': True, 'message': 'Finding your time zone from your internet connection…'}
        self.push()
        self.region_task = asyncio.create_task(self.detect_region(manual))

    async def detect_region(self, manual):
        zone = None
        try:
            zone = await asyncio.to_thread(geoip_zone)
        except Exception:
            zone = None
        zone = canonical_zone(zone, self.static) if zone else None
        region = {**self.state['region'], 'busy': False}
        if zone is None:
            self.region_attempted = False  # A later connection may work.
            region['message'] = 'Your time zone could not be detected. Choose it from the list.'
        else:
            region.update(detected=zone, message=f'Detected {zone} from your internet connection.')
            if self.draft['tzSource'] != 'manual' and self.state['phase'] not in ('installing', 'complete'):
                self.draft.update(timezone=zone, tzSource='detected')
                if self.state['phase'] == 'review':
                    with contextlib.suppress(Failure):
                        self.request_review()
        self.state['region'] = region
        self.push()

    # ── diagnostics ──────────────────────────────────────────────────────────
    def query(self, writer, kind, operation):
        """Keep slow read-only queries out of the connection's input loop.

        Coalesce repeated Refresh presses, and cancel the task on disconnect.
        Draft edits and keyboard actions must not wait for diagnostics or lsblk.
        """
        key = (writer, kind)
        if key in self.queries:
            return

        async def reply():
            try:
                self.send(writer, await operation())
            finally:
                self.queries.pop(key, None)

        self.queries[key] = asyncio.create_task(reply())

    async def list_usb(self):
        return {'type': 'usb', 'targets': await asyncio.to_thread(usb_targets), 'error': ''}

    async def details(self):
        process = None
        try:
            process = await asyncio.create_subprocess_exec(
                'cybexos-install', '--diagnostics', stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.DEVNULL, limit=MAX_LINE)
            output, _ = await asyncio.wait_for(process.communicate(), 20)
            result = json.loads(output)
            if process.returncode != 0 or not isinstance(result.get('text'), str):
                raise ValueError('invalid details')
            return {'type': 'details', 'text': result['text'], 'truncated': bool(result.get('truncated')), 'error': ''}
        except (OSError, ValueError, AttributeError, asyncio.TimeoutError):
            return {'type': 'details', 'text': '', 'truncated': False,
                    'error': 'Installation details could not be read. On the recovery shell, run: less /run/cybexos-installer.log'}
        finally:
            if process is not None and process.returncode is None:
                with contextlib.suppress(ProcessLookupError):
                    process.kill()
                await process.wait()

    # ── serving ──────────────────────────────────────────────────────────────
    async def client(self, reader, writer):
        self.clients.add(writer)
        self.send(writer, self.static)
        self.send(writer, self.snapshot())
        try:
            while True:
                try:
                    line = await reader.readline()
                except (ValueError, asyncio.LimitOverrunError, ConnectionError, OSError):
                    break
                if not line:
                    break
                try:
                    request = json.loads(line)
                except (ValueError, UnicodeError):
                    continue
                if isinstance(request, dict):
                    try:
                        await self.handle_request(writer, request)
                    except Failure as error:
                        self.update(error=str(error))
                    finally:
                        request.clear()
                with contextlib.suppress(OSError, RuntimeError, ConnectionError):
                    await writer.drain()
        finally:
            self.clients.discard(writer)
            self.screens.discard(writer)
            queries = [task for (client, _), task in self.queries.items() if client is writer]
            for task in queries:
                task.cancel()
            await asyncio.gather(*queries, return_exceptions=True)
            with contextlib.suppress(OSError, RuntimeError):
                writer.close()

    async def ticker(self):
        while True:
            await asyncio.sleep(5)
            if self.state['phase'] == 'installing':
                self.push()

    async def shutdown(self, stop):
        """Stop serving. An idle worker is cancelled; an installation is not.

        The unit uses KillMode=process, so a running installation outlives a
        service restart. Before installation starts, cancelling releases the
        installer lock for the text installer or the next daemon.
        """
        worker = self.worker
        if worker is not None and worker.returncode is None and self.state['phase'] not in ('installing',):
            with contextlib.suppress(Failure, OSError, RuntimeError):
                self.worker_send({'action': 'cancel'})
                worker.stdin.close()
            try:
                await asyncio.wait_for(worker.wait(), 10)
            except asyncio.TimeoutError:
                with contextlib.suppress(ProcessLookupError):
                    worker.terminate()
        stop.set()

    async def serve(self):
        RUNTIME.mkdir(parents=True, exist_ok=True)
        with contextlib.suppress(FileNotFoundError):
            SOCKET.unlink()
        server = await asyncio.start_unix_server(self.client, path=str(SOCKET), limit=MAX_LINE)
        group = os.environ.get('CYBEXOS_INSTALLER_GROUP', 'cybexos-installer')
        with contextlib.suppress(KeyError, OSError):
            import grp
            os.chown(SOCKET, 0, grp.getgrnam(group).gr_gid)
        SOCKET.chmod(0o660)
        await self.start_worker()
        tasks = [asyncio.create_task(self.watch_network()), asyncio.create_task(self.ticker())]
        stop = asyncio.Event()
        loop = asyncio.get_running_loop()
        for number in (signal.SIGTERM, signal.SIGINT):
            loop.add_signal_handler(number, lambda: asyncio.ensure_future(self.shutdown(stop)))
        await stop.wait()
        for task in tasks:
            task.cancel()
        if self.network_task is not None:
            self.network_task.cancel()
            with contextlib.suppress(asyncio.CancelledError):
                await self.network_task
        if self.pending_network and self.pending_network[1]:
            self.pending_network[1].clear()
        self.pending_network = None
        # Closing the clients first lets the process exit promptly; the server
        # would otherwise wait for the screen's open connection.
        for writer in list(self.clients):
            with contextlib.suppress(OSError, RuntimeError):
                writer.close()
        server.close()
        with contextlib.suppress(FileNotFoundError):
            SOCKET.unlink()


def summarize_network(result):
    devices = [d for d in result.get('devices', []) if isinstance(d, dict)]
    connected = [d for d in devices if d.get('connected') and d.get('type') in ('ethernet', 'wifi')]
    primary = next((d for d in connected if d.get('type') == 'ethernet'), connected[0] if connected else None)
    wifi = result.get('wifi') or {}
    networks = []
    seen = set()
    for network in sorted(wifi.get('networks') or [], key=lambda n: -int(n.get('signal') or 0)):
        ssid = str(network.get('ssid') or '')
        if not ssid or ssid in seen:
            continue
        seen.add(ssid)
        networks.append({'ssid': ssid[:64], 'signal': int(network.get('signal') or 0),
                         'security': str(network.get('security') or '')[:40],
                         'connected': bool(network.get('connected')), 'known': bool(network.get('known')),
                         'uuid': str(network.get('profileUuid') or '')})
    return {'connected': primary is not None,
            'kind': primary.get('type', '') if primary else '',
            'interface': primary.get('interface', '') if primary else '',
            'name': (primary.get('ssid') or primary.get('connection') or '') if primary else '',
            'address': primary.get('ipv4', '') if primary else '',
            'ethernetCable': any(d.get('type') == 'ethernet' and d.get('stateCode', 0) > 20 for d in devices),
            'wifi': {'interface': str(wifi.get('interface') or ''), 'networks': networks[:24]}}


def geoip_zone():
    request = urllib.request.Request(GEO_URL, headers={'User-Agent': 'CybexOS-Installer/2'})
    with urllib.request.urlopen(request, timeout=6) as response:
        data = json.loads(response.read(65536))
    zone = data.get('timezone') if isinstance(data, dict) else None
    return zone if isinstance(zone, str) and len(zone) <= 64 else None


async def run_quiet(command):
    with contextlib.suppress(OSError):
        process = await asyncio.create_subprocess_exec(*command, stdin=asyncio.subprocess.DEVNULL,
                                                       stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.DEVNULL)
        with contextlib.suppress(asyncio.TimeoutError):
            await asyncio.wait_for(process.wait(), 30)


# ── saving the log to another USB stick ───────────────────────────────────────
WRITABLE = ('vfat', 'exfat', 'ext4', 'ext3', 'ext2', 'ntfs', 'ntfs3', 'btrfs', 'xfs')


def usb_targets():
    try:
        tree = json.loads(subprocess.run(['lsblk', '--json', '--bytes', '-o', 'PATH,TYPE,RM,TRAN,FSTYPE,LABEL,SIZE,MOUNTPOINTS,RO'],
                                         capture_output=True, text=True, timeout=10).stdout)['blockdevices']
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        return []
    targets = []
    for disk in tree:
        removable = disk.get('rm') in (True, '1', 1) or disk.get('tran') == 'usb'
        if not removable:
            continue
        nodes = [disk, *disk.get('children', [])]
        # The installation medium itself is read-only ISO 9660 and never offered.
        if any(node.get('fstype') == 'iso9660' or node.get('label') == 'CYBEXOS_INSTALL' for node in nodes):
            continue
        for node in nodes:
            if node.get('fstype') in WRITABLE and not node.get('ro') and not any(node.get('mountpoints') or []):
                targets.append({'device': node['path'], 'label': str(node.get('label') or node['path'])[:40],
                                'size': int(node.get('size') or 0)})
    return targets


def save_log(device):
    if device not in {target['device'] for target in usb_targets()}:
        return {'type': 'usb', 'targets': usb_targets(), 'error': 'That USB stick is no longer available.', 'saved': ''}
    mountpoint = RUNTIME / 'usb'
    mountpoint.mkdir(parents=True, exist_ok=True)
    name = 'cybexos-install-' + datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%d-%H%M%S') + '.log'
    mounted = False
    try:
        subprocess.run(['mount', '-o', 'nosuid,nodev,noexec', device, str(mountpoint)], check=True,
                       capture_output=True, timeout=30)
        mounted = True
        shutil.copyfile(INSTALL_LOG, mountpoint / name)
        os.sync()
        return {'type': 'usb', 'targets': [], 'error': '', 'saved': name}
    except (OSError, subprocess.SubprocessError):
        return {'type': 'usb', 'targets': usb_targets(), 'error': 'The log could not be written to that USB stick.', 'saved': ''}
    finally:
        if mounted:
            subprocess.run(['umount', str(mountpoint)], capture_output=True, timeout=30)


# ── a small client for qualification and the recovery shell ──────────────────
def client_main(arguments):
    import socket
    with socket.socket(socket.AF_UNIX) as connection:
        try:
            connection.connect(str(SOCKET))
        except OSError as error:
            print(f'The installer service is not running ({error.strerror}).', file=sys.stderr)
            return 2
        stream = connection.makefile('rwb', buffering=0)
        for request in arguments.request:
            stream.write((request.strip() + '\n').encode())
        deadline = time.monotonic() + arguments.timeout
        connection.settimeout(arguments.timeout)
        while time.monotonic() < deadline:
            line = stream.readline(MAX_LINE)
            if not line:
                break
            message = json.loads(line)
            if message.get('type') == arguments.wait_type and (
                    not arguments.wait_phase or message.get('phase') in arguments.wait_phase.split(',')):
                print(json.dumps(message))
                return 0
        return 1


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--client', action='store_true', help='Send requests and print one matching message')
    parser.add_argument('--request', action='append', default=[], help='JSON request line (client mode)')
    parser.add_argument('--wait-type', default='state')
    parser.add_argument('--wait-phase', default='')
    parser.add_argument('--timeout', type=float, default=10)
    parser.add_argument('--dump-static', action='store_true', help='Print the static message (previews and tests)')
    arguments, extra = parser.parse_known_args()
    if arguments.client:
        raise SystemExit(client_main(arguments))
    if arguments.dump_static:
        print(json.dumps(Daemon.static_data(None), ensure_ascii=False))
        return
    if not (ETC / 'installer').is_file():
        raise SystemExit('The installer service runs only on the Cybex OS installation ISO')
    os.umask(0o077)
    worker_args = extra + os.environ.get('CYBEXOS_INSTALLER_WORKER_ARGS', '').split()
    asyncio.run(Daemon(worker_args).serve())


if __name__ == '__main__':
    main()
