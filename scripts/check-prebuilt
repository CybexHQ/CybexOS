#!/usr/bin/env python3
"""List what a Cybex OS system would compile instead of downloading.

Walks the system's derivation graph from its root, asking cache.nixos.org for
each output, independent of what this computer's store already holds. A
cached output covers its whole subtree. What remains is a fresh machine's
build plan, judged as the updater judges it (`prebuilt.compiles`):
configuration files (local-only by design), fixed-output downloads and the
system's expected local builds (`system.build.cybexosExpectedBuilds`: Cybex
OS's own packages and their declared parts, unfree vendor downloads, kernel
modules) are allowed. What those builds need is checked too; only
`cybexos.updates.expectedBuilds` covers what it needs
(`system.build.cybexosDeclaredBuilds`). Anything else is a Nixpkgs package
that NixOS has not prebuilt, or a configuration that changed one; the command
lists those and exits 1.

Settings' pointer themes are downloaded later, on demand, from the same cache
(`system.build.cybexosPointerDownloads`); a path it does not hold is listed as
`pointer theme: PATH` and fails the check too.

NixOS generates much of a system's configuration (pam.d, the initrd, setuid
wrappers, dconf and AppArmor rules) without marking it local-only. Such a
derivation has no source of its own (`src`/`srcs`; `prebuilt.kind`): it is
listed on stderr as configuration, and its inputs are still checked, so a
package it would compile is still reported.

    scripts/check-prebuilt                       # the default product system
    scripts/check-prebuilt --nvidia              # with NVIDIA drivers
    scripts/check-prebuilt --catalogue           # plus every Software profile app
"""
import argparse
import json
import subprocess
import sys
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'lifecycle'))
from cybexos.prebuilt import compiles, derivation_graph, kind, name  # noqa: E402

NIX = ['nix', '--extra-experimental-features', 'nix-command flakes']


def nix(*arguments):
    """Nix's stdout; on failure, exit with Nix's own error message."""
    result = subprocess.run(NIX + list(arguments), capture_output=True, text=True)
    if result.returncode:
        sys.exit(result.stderr.strip() or 'nix ' + arguments[0] + ' failed')
    return result.stdout


def evaluate(nvidia, packages):
    expression = '''
      let
        flake = builtins.getFlake (toString %(root)s);
        system = flake.inputs.nixpkgs.lib.nixosSystem {
          system = "x86_64-linux";
          modules = [ flake.nixosModules.default (%(root)s + "/nix/tests/machine.nix") ({ lib, ... }: {
            cybexos.features = { proprietary = lib.mkForce true; steam = lib.mkForce true; docker = lib.mkForce true; };
            cybexos.hardware.nvidia = %(nvidia)s;
            cybexos.software.packages = builtins.fromJSON %(packages)s;
          }) ];
        };
      in { root = system.config.system.build.toplevel.drvPath;
           expected = system.config.system.build.cybexosExpectedBuilds;
           vendor = system.config.system.build.cybexosVendorBuilds;
           declared = system.config.system.build.cybexosDeclaredBuilds;
           pointers = system.config.system.build.cybexosPointerDownloads; }
    ''' % {'root': json.dumps(str(ROOT)), 'nvidia': 'true' if nvidia else 'false',
           'packages': json.dumps(json.dumps(packages))}
    return json.loads(nix('eval', '--impure', '--json', '--expr', expression))


def cached(path):
    digest = Path(path).name.split('-', 1)[0]
    try:
        with urllib.request.urlopen(f'https://cache.nixos.org/{digest}.narinfo', timeout=30):
            return True
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return False
        raise


def walk(root, expected, vendor, declared):
    graph = derivation_graph(json.loads(nix('derivation', 'show', '-r', root)))
    seen, frontier, missing = set(), [root], set()
    with ThreadPoolExecutor(32) as pool:
        while frontier:
            batch = [d for d in dict.fromkeys(frontier) if d not in seen]
            seen.update(batch)
            outputs = [next((o['path'] for o in graph[d]['outputs'].values() if 'path' in o), None) for d in batch]
            present = list(pool.map(lambda path: path is not None and cached(path), outputs))
            frontier = []
            for drv, hit in zip(batch, present):
                if not hit:
                    missing.add(drv)
                    frontier.extend(graph[drv].get('inputDrvs') or {})
    plan = {drv: graph[drv] for drv in missing}
    found = compiles(lambda *arguments, **options: json.dumps({d: plan[d] for d in arguments[3:]}),
                     sorted(missing), root=root, expected=expected, vendor=vendor, declared=declared)
    # Configuration a declared build needs is part of that build.
    covered, frontier = set(), [d for d in declared if d in missing and d not in vendor]
    while frontier:
        drv = frontier.pop()
        if drv not in covered:
            covered.add(drv)
            frontier.extend(d for d in graph[drv].get('inputDrvs') or {} if d in missing)
    configured = sorted({name(d) for d in missing - covered if kind(graph[d]) == 'configuration'})
    return found, configured, len(missing)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--nvidia', action='store_true', help='include NVIDIA drivers')
    parser.add_argument('--catalogue', action='store_true', help='add every Software profile app')
    arguments = parser.parse_args()
    packages = []
    if arguments.catalogue:
        catalogue = json.loads((ROOT / 'desktop/software/catalogue.json').read_text())
        apps = {app['id']: app for app in catalogue['apps']}
        packages = sorted({apps[i]['attribute'] for p in catalogue['profiles'] for i in p['apps']})
    info = evaluate(arguments.nvidia, packages)
    found, configured, local = walk(info['root'], info['expected'], info['vendor'], info['declared'])
    print(f'{local} derivations build locally; {len(info["expected"])} expected local builds allowed.', file=sys.stderr)
    if configured:
        print(f'{len(configured)} configuration builds: ' + ', '.join(configured), file=sys.stderr)
    with ThreadPoolExecutor(8) as pool:
        missing = [path for path, hit in zip(info['pointers'], pool.map(cached, info['pointers'])) if not hit]
    print(f'{len(info["pointers"])} pointer theme downloads checked.', file=sys.stderr)
    for item in found + ['pointer theme: ' + path for path in missing]:
        print(item)
    return 1 if found or missing else 0


if __name__ == '__main__':
    sys.exit(main())
