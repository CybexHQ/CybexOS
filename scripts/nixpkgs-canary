#!/usr/bin/env python3
"""Check Cybex OS against Nixpkgs revisions machines will receive next.

Installed machines follow nixos-unstable themselves, so a Nixpkgs change that
removes or renames something Cybex OS uses breaks their next update (as
Brave's removal did on 2026-11-03). Changes reach Nixpkgs master days before
the channel. This evaluates main and the newest beta and stable releases
against the channel head and master, plus the next stable branch once it
exists, and reports errors and new evaluation warnings.

With --build it also builds each source's expected local builds (Cybex OS's
own packages and the unfree vendor downloads machines compile themselves)
against the channel head. NixOS's cache has everything else, so these are
what can still fail on a machine (Voxtype on 2026-11-10). Each source's own
scripts/check-prebuilt names the packages its machines' updater holds back
until NixOS builds them: a build that fails there means machines wait, and
any other failure is one they would hit.

With --verified FILE (and --build) it also records the channel revision as
verified for each published release that passes completely: every target
evaluates, the release's check-prebuilt holds nothing (with and without
NVIDIA) and every expected local build builds. Machines move their Nixpkgs
only to a revision verified for the release they run (lifecycle/cybexos/
verified.py); the workflow publishes FILE on the nixpkgs-verified branch.

  scripts/nixpkgs-canary [--sources main,beta,stable,TAG...] [--build] [--verified FILE] [--report DIR]

Exit status 1 means an evaluation or a build failed. The nixpkgs-canary
workflow runs it daily with --build and keeps a GitHub issue open while it
fails. Locally it needs git, gh (for the release tags) and Nix.
"""
import argparse
from datetime import datetime, timezone
import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
NIX = ['nix', '--extra-experimental-features', 'nix-command flakes']
# Machine configurations a release ships: the default VM/installation set,
# the full default application selection (with Google Chrome, ChatGPT, Steam),
# the XPS stack and the NVIDIA driver.
TARGETS = ['product', 'system', 'xps-system', 'nvidia-evaluation']
# The stable branch that follows the current one. NixOS 26.11 is planned for
# 2026-11-23; once it exists, Cybex OS moves to it (CLAUDE.md).
NEXT_STABLE = 'nixos-26.11'
# The full default application selection (the `product` check), evaluated as
# scripts/check-prebuilt evaluates it.
EXPECTED = '''
  let
    flake = builtins.getFlake (toString %(root)s);
    system = flake.inputs.nixpkgs.lib.nixosSystem {
      system = "x86_64-linux";
      modules = [ flake.nixosModules.default (%(root)s + "/nix/tests/machine.nix") ({ lib, ... }: {
        cybexos.features = { proprietary = lib.mkForce true; steam = lib.mkForce true; docker = lib.mkForce true; };
      }) ];
    };
  in system.config.system.build.cybexosExpectedBuilds
'''
# A derivation whose own builder failed, in Nix's older and newer wording.
FAILED = re.compile(r"Cannot build '(/nix/store/[^']+\.drv)'\.\s+Reason: (?!\d+ dependenc)"
                    r"|builder for '(/nix/store/[^']+\.drv)' failed"
                    r"|hash mismatch in fixed-output derivation '(/nix/store/[^']+\.drv)'")
UNBUILT = re.compile(r"Cannot build '(/nix/store/[^']+\.drv)'|builder for '(/nix/store/[^']+\.drv)' failed"
                     r"|dependencies of derivation '(/nix/store/[^']+\.drv)' failed")
ANSI = re.compile(r'\x1b\[[0-9;]*m')
NOISE = ('warning: Git tree', "warning: unknown setting", 'warning: ignoring untrusted',
         'warning: Nix search path entry', 'warning: not writing modified lock file')


def run(*args, cwd=None):
    return subprocess.run(list(args), cwd=cwd, text=True, capture_output=True)


def sources(wanted):
    """name -> git revision; releases resolved from GitHub's release list."""
    result = {}
    if 'main' in wanted:
        result['main'] = run('git', 'rev-parse', 'HEAD', cwd=ROOT).stdout.strip()
    if {'beta', 'stable'} & set(wanted):
        listing = run('gh', 'release', 'list', '--repo', 'CybexHQ/CybexOS', '--limit', '30',
                      '--json', 'tagName,isPrerelease,isLatest,publishedAt')
        if listing.returncode:
            raise SystemExit('nixpkgs-canary: cannot list releases: ' + listing.stderr.strip())
        releases = sorted(json.loads(listing.stdout), key=lambda r: r['publishedAt'], reverse=True)
        for name, pick in (('beta', lambda r: True), ('stable', lambda r: r['isLatest'])):
            found = next((r['tagName'] for r in releases if pick(r)), None)
            if name in wanted and found:
                run('git', 'fetch', '--quiet', 'origin', 'tag', found, cwd=ROOT)
                result[name] = found
    # Anything else names a revision or tag directly (v1.0.23, a commit).
    for name in wanted:
        if name not in ('main', 'beta', 'stable'):
            run('git', 'fetch', '--quiet', 'origin', 'tag', name, cwd=ROOT)
            result[name] = name
    return result


def nixpkgs(ref):
    """The current revision of a Nixpkgs branch, or None if it does not exist."""
    meta = run(*NIX, 'flake', 'metadata', '--json', '--refresh', f'github:NixOS/nixpkgs/{ref}')
    if meta.returncode:
        return None
    locked = json.loads(meta.stdout)['locked']
    return {'ref': ref, 'rev': locked['rev'], 'date': locked.get('lastModified'), 'narHash': locked.get('narHash')}


def located(trace, source):
    """The module that used what failed: `while evaluating definitions from` lines."""
    found = []
    for path in re.findall(r"definitions from `/nix/store/[^/]+-source/([^']+)'", trace):
        owner = 'Cybex OS' if (source / path).exists() else 'Nixpkgs'
        found.append(f'{owner}: {path}')
    return found[-1] if found else ''


def evaluate(source, target, rev=None):
    """drvPath of checks.<target>; errors and warnings from its evaluation."""
    args = [*NIX, 'eval', '--raw', f'git+file://{source}#checks.x86_64-linux.{target}.drvPath']
    if rev:
        args += ['--override-input', 'nixpkgs', f'github:NixOS/nixpkgs/{rev}']
    result = run(*args)
    text = ANSI.sub('', result.stderr)
    warnings = sorted({line.strip() for line in text.splitlines()
                       if re.match(r'\s*(evaluation warning:|trace: warning:|warning:)', line)
                       and not line.strip().startswith(NOISE)})
    outcome = {'ok': result.returncode == 0, 'warnings': warnings}
    if result.returncode:
        errors = re.findall(r'(?m)^\s*error:\s*(.+(?:\n(?!\s*(?:…|error:)).+)*)', text)
        outcome['error'] = (errors[-1].strip() if errors else text.strip()[-600:])[:1200]
        outcome['location'] = located(text, source)
    return outcome


def check(name, revision, branches, workspace):
    """One source against its own lock (baseline) and each candidate."""
    source = Path(workspace) / name
    if revision == run('git', 'rev-parse', 'HEAD', cwd=ROOT).stdout.strip() and name == 'main':
        source = ROOT
    else:
        subprocess.run(['git', 'worktree', 'add', '--quiet', '--detach', str(source), revision],
                       cwd=ROOT, check=True)
    results = []
    try:
        for target in TARGETS:
            baseline = evaluate(source, target)
            for branch in branches:
                outcome = evaluate(source, target, branch['rev'])
                outcome['new_warnings'] = sorted(set(outcome['warnings']) - set(baseline['warnings']))
                results.append({'source': name, 'revision': revision, 'target': target,
                                 'nixpkgs': branch, 'baseline_ok': baseline['ok']} | outcome)
                state = 'ok' if outcome['ok'] else 'FAILED'
                print(f"{name} {target} vs {branch['ref']} {branch['rev'][:12]}: {state}", flush=True)
    finally:
        if source != ROOT:
            subprocess.run(['git', 'worktree', 'remove', '--force', str(source)], cwd=ROOT)
    return results


def tail(text, lines=25):
    return '\n'.join(ANSI.sub('', text).strip().splitlines()[-lines:])


def derivation(path):
    """`/nix/store/<hash>-codex-0.167.0.drv` -> `codex-0.167.0`."""
    base = path.rsplit('/', 1)[-1].split('-', 1)[-1]
    return base[:-4] if base.endswith('.drv') else base


def build(name, revision, branch, workspace):
    """A source's expected local builds against one Nixpkgs revision."""
    source = Path(workspace) / (name + '-build')
    subprocess.run(['git', 'worktree', 'add', '--quiet', '--detach', str(source), revision], cwd=ROOT, check=True)
    result = {'source': name, 'revision': revision, 'nixpkgs': branch, 'ok': False,
              'expected': 0, 'built': 0, 'held': [], 'heldNvidia': [], 'failed': []}
    try:
        # Machines resolve Cybex OS against their own Nixpkgs the same way.
        step = run(*NIX, 'flake', 'lock', '--override-input', 'nixpkgs', f"github:NixOS/nixpkgs/{branch['rev']}",
                   cwd=source)
        if step.returncode:
            return result | {'error': tail(step.stderr)}
        holds = {}
        for key, flags in (('held', []), ('heldNvidia', ['--nvidia'])):
            step = run(sys.executable, '-I', '-B', str(source / 'scripts/check-prebuilt'), *flags, cwd=source)
            holds[key] = [line.strip() for line in step.stdout.splitlines()
                          if line.strip() and not line.startswith('pointer theme: ')]
            if step.returncode not in (0, 1) or (step.returncode and not step.stdout.strip()):
                return result | {'error': tail(step.stderr)}
        held = holds['held']
        result['heldNvidia'] = holds['heldNvidia']
        step = run(*NIX, 'eval', '--impure', '--json', '--expr', EXPECTED % {'root': json.dumps(str(source))}, cwd=source)
        if step.returncode:
            return result | {'error': tail(step.stderr)}
        expected = json.loads(step.stdout)
        print(f"{name}: building {len(expected)} expected local builds against {branch['ref']} {branch['rev'][:12]}",
              flush=True)
        step = run(*NIX, 'build', '--no-link', '--keep-going', *(path + '^*' for path in expected), cwd=source)
        text = ANSI.sub('', step.stderr)
        failed = sorted({next(filter(None, match.groups())) for match in FAILED.finditer(text)})
        unbuilt = {next(filter(None, match.groups())) for match in UNBUILT.finditer(text)} & set(expected)
        result |= {'expected': len(expected), 'built': len(expected) - len(unbuilt), 'held': held}
        for path in failed:
            waits = derivation(path) in held
            log = '' if waits else tail(run(*NIX, 'log', path).stdout)
            result['failed'].append({'derivation': path, 'name': derivation(path), 'held': waits, 'log': log})
        if step.returncode and not failed:
            return result | {'error': tail(text)}
        result['ok'] = all(item['held'] for item in result['failed'])
        return result
    finally:
        subprocess.run(['git', 'worktree', 'remove', '--force', str(source)], cwd=ROOT)


def release(revision):
    """`v1.0.32` -> `1.0.32`; None for a branch or commit."""
    match = re.fullmatch(r'v(\d+\.\d+\.\d+(?:-(?:beta|rc)\.\d+)?)', revision)
    return match[1] if match else None


def verifications(results, builds, channel, aliases):
    """Release versions that pass completely against the channel revision.

    `aliases` maps a source name to the other sources at its commit (the
    newest beta is often the newest stable release too).
    """
    versions = set()
    for b in builds:
        evaluated = [r for r in results if r['source'] == b['source'] and r['nixpkgs']['ref'] == channel['ref']]
        if (b['nixpkgs']['rev'] != channel['rev'] or b.get('skipped') or b.get('error') or b['failed']
                or b['held'] or b.get('heldNvidia') or b['built'] != b['expected'] or not b['expected']
                or not evaluated or not all(r['ok'] for r in evaluated)):
            continue
        versions |= {release(revision) for revision in [b['revision'], *aliases.get(b['source'], [])]} - {None}
    return sorted(versions)


def verify(record, channel, versions, now, keep=60):
    """`record` with the channel revision verified for `versions` (lifecycle/cybexos/verified.py)."""
    record = record if isinstance(record, dict) and record.get('schema') == 1 else {'schema': 1, 'branches': {}}
    entries = [dict(item) for item in record.get('branches', {}).get(channel['ref'], [])]
    if not versions or not channel.get('narHash') or not isinstance(channel.get('date'), int):
        return record
    for item in entries:
        if item['rev'] == channel['rev']:
            item['releases'] = sorted(set(item['releases']) | set(versions))
            item['verifiedAt'] = now
            break
    else:
        entries.append({'rev': channel['rev'], 'narHash': channel['narHash'], 'lastModified': channel['date'],
                        'releases': list(versions), 'verifiedAt': now})
    entries.sort(key=lambda item: item['lastModified'], reverse=True)
    return {'schema': 1, 'branches': dict(record.get('branches', {}), **{channel['ref']: entries[:keep]})}


def markdown_builds(builds):
    if not builds:
        return []
    branch = builds[0]['nixpkgs']
    lines = ['', f"Built the product system's expected local builds against `{branch['ref']}` {branch['rev'][:12]}:", '']
    for b in builds:
        head = f"- **{b['source']}** (`{b['revision'][:12]}`): "
        if b.get('skipped'):
            lines.append(head + 'not built; it does not evaluate (above).')
            continue
        if b.get('error'):
            lines += [head + 'the build check itself failed:', '', '  ```', *('  ' + line for line in b['error'].splitlines()),
                      '  ```']
            continue
        lines.append(head + f"{b['built']} of {b['expected']} built.")
        waiting = sorted({item['name'] for item in b['failed'] if item['held']} | set(b['held'])
                         | set(b.get('heldNvidia', [])))
        if waiting:
            lines.append(f"  NixOS hasn't built {', '.join(f'`{n}`' for n in waiting)}; machines on this release hold "
                         'the NixOS update back until it has.')
        for item in b['failed']:
            if item['held']:
                continue
            lines += [f"  `{item['name']}` fails to build, and machines on this release would try to build it when "
                      'they take this Nixpkgs:', '', '  ```', *('  ' + line for line in item['log'].splitlines()), '  ```']
    return lines


def markdown(results, branches, builds=()):
    heads = ', '.join(f"`{b['ref']}` {b['rev'][:12]}" for b in branches)
    lines = [f'Evaluated against {heads}.', '']
    failed = [r for r in results if not r['ok']]
    for r in failed:
        where = f" ({r['location']})" if r.get('location') else ''
        own = '' if r['baseline_ok'] else ' It also fails with its own locked Nixpkgs.'
        lines += [f"- **{r['source']}** (`{r['revision'][:12]}`) `{r['target']}` fails with "
                  f"`{r['nixpkgs']['ref']}`{where}:{own}", '', '  ```', *('  ' + line for line in r['error'].splitlines()),
                  '  ```']
    warned = {}
    for r in results:
        for warning in r['new_warnings']:
            warned.setdefault(warning, set()).add(f"{r['source']} with {r['nixpkgs']['ref']}")
    if warned:
        lines += ['', 'New evaluation warnings (often a removal or rename that is coming):', '']
        lines += [f"- `{w[:300]}` ({', '.join(sorted(where))})" for w, where in sorted(warned.items())]
    if not failed and not warned:
        lines.append('Every source evaluates without new warnings.')
    lines += markdown_builds(builds)
    return '\n'.join(lines) + '\n'


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--sources', default='main,beta,stable')
    parser.add_argument('--build', action='store_true',
                        help="also build each source's expected local builds against the channel head")
    parser.add_argument('--report', type=Path, help='write report.json and report.md here')
    parser.add_argument('--verified', type=Path,
                        help='update this verified Nixpkgs record (with --build) for the releases that pass')
    options = parser.parse_args(argv)
    branches = [b for b in (nixpkgs(ref) for ref in ('nixos-unstable', 'master', NEXT_STABLE)) if b]
    if len(branches) < 2:
        raise SystemExit('nixpkgs-canary: cannot resolve the Nixpkgs channel and master')
    seen, results, builds, aliases = {}, [], [], {}
    with tempfile.TemporaryDirectory(prefix='nixpkgs-canary.') as workspace:
        for name, revision in sources(options.sources.split(',')).items():
            commit = run('git', 'rev-parse', revision + '^{commit}', cwd=ROOT).stdout.strip()
            if commit in seen:
                aliases.setdefault(seen[commit], []).append(revision)
                continue
            seen[commit] = name
            evaluated = check(name, revision, branches, workspace)
            results += evaluated
            # Only the channel is in NixOS's cache; master would compile everything.
            channel = next((b for b in branches if b['ref'] == 'nixos-unstable'), None)
            if options.build and channel:
                if any(r['target'] == 'product' and r['nixpkgs']['ref'] == channel['ref'] and not r['ok']
                       for r in evaluated):
                    builds.append({'source': name, 'revision': revision, 'nixpkgs': channel, 'ok': True, 'skipped': True})
                else:
                    builds.append(build(name, revision, channel, workspace))
    report = markdown(results, branches, builds)
    channel = next((b for b in branches if b['ref'] == 'nixos-unstable'), None)
    versions = verifications(results, builds, channel, aliases) if options.build and channel else []
    if options.verified:
        try:
            record = json.loads(options.verified.read_text())
        except (OSError, ValueError):
            record = None
        updated = verify(record, channel, versions, datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'))
        changed = updated != record
        if changed:
            options.verified.write_text(json.dumps(updated, indent=2, sort_keys=True) + '\n')
        report += (f"\nVerified `{channel['ref']}` {channel['rev'][:12]} for Cybex OS {', '.join(versions)}: "
                   'machines on these releases take it with their next update.\n' if versions else
                   f"\nNo release was verified with `{channel['ref']}` {channel['rev'][:12]}: machines keep the "
                   'NixOS packages they have.\n')
        if options.report:
            options.report.mkdir(parents=True, exist_ok=True)
            (options.report / 'verified').write_text(' '.join(versions) + '\n' if changed and versions else '\n')
    print(report)
    if options.report:
        options.report.mkdir(parents=True, exist_ok=True)
        (options.report / 'report.json').write_text(json.dumps({'evaluations': results, 'builds': builds}, indent=2) + '\n')
        (options.report / 'report.md').write_text(report)
    failed = any(not r['ok'] for r in results) or any(not b['ok'] for b in builds)
    warned = any(r['new_warnings'] for r in results)
    if options.report:
        (options.report / 'status').write_text('failed\n' if failed else 'warnings\n' if warned else 'ok\n')
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
